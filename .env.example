DATABASE_URL=postgresql://corecast_user:corecast_pass@db:5432/corecast_db
SECRET_KEY=corecast-dev-secret-change-me

# Metas de SLA parametrizaveis (horas) para prioridades 3 e 4
SLA_META_P3_HORAS=12
SLA_META_P4_HORAS=32

# Handoff N1 -> N2: acima deste tempo (minutos) o repasse e considerado em atraso
LIMITE_REPASSE_N2_MINUTOS=30

# Usuario admin criado automaticamente na primeira execucao
ADMIN_EMAIL=admin@corecast.local
ADMIN_SENHA=admin123
